# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Ruff stuff:
.ruff_cache/

# PyPI configuration file
.pypirc

# Cursor  
#  Cursor is an AI-powered code editor.`.cursorignore` specifies files/directories to 
#  exclude from AI features like autocomplete and code analysis. Recommended for sensitive data
#  refer to https://docs.cursor.com/context/ignore-files
.cursorignore
.cursorindexingignore
# Throughput / one-off experiments: model outputs, server logs, result JSON.
/experiments/

# Claude Code per-machine settings (the .local variants are personal by convention).
.claude/settings.local*.json

# The four original task bundles, superseded by tasks/prism_v1 (2026-09-04). Kept on
# disk under tasks/archive/ so a published number can still be traced back to the
# code that produced it, but untracked: they are read-only history, and having two
# copies of every task in the tree is what made "which one is live?" hard to answer.
/tasks/archive/

# Internal working notes: decisions, incident write-ups, the paper LaTeX, and
# PRIVATE_TODO.md. Useful to us, not part of what we publish.
/claude_docs/

# Built release payloads (scripts/build_hf_dataset.py). Regenerated, not tracked;
# the card template that feeds it is at release/dataset_card.md and IS tracked.
/release/creativityprism_v1/

# Creativity Index upstream (GXimingLu/creativity_index) carries no license, so its
# data may not be redistributed. Kept on disk for building the fetch script; never
# tracked. Users obtain it from upstream themselves.
/research/data_cleaning/raw_data/creativity_index/
# Same reason: its rows carry the upstream human-written texts in full.
/research/data_cleaning/processed/creativity_index.json

# The benchmark data itself. It is published as joeyhou/creativityprism_v1 on the
# Hub and pulled with `creativityprism data pull`, so the repository holds the code
# that runs it and nothing that anyone else owns. Keeping a second copy in git is
# what let an unlicensed upstream's text sit here for sixteen months.
/tasks/prism_v1/data/processed/
